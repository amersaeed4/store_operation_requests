<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">
        <!-- sequence for issue requests -->
        <record id="ir_sequence_employee_purchase_requisition" model="ir.sequence">
            <field name="name">Issue Requests</field>
            <field name="code">employee.purchase.requisition</field>
            <field name="prefix">EPR</field>
            <field name="padding">5</field>
            <field eval="1" name="number_next"/>
            <field eval="1" name="number_increment"/>
            <field eval="False" name="company_id"/>
        </record>
        <!-- sequence for return requests -->
        <record id="ir_sequence_employee_return_request" model="ir.sequence">
            <field name="name">Return Requests</field>
            <field name="code">employee.return.request</field>
            <field name="prefix">RET</field>
            <field name="padding">5</field>
            <field eval="1" name="number_next"/>
            <field eval="1" name="number_increment"/>
            <field eval="False" name="company_id"/>
        </record>
    </data>
</odoo>