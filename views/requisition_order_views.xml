<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--List view for requisition order-->
    <record id="requisition_order_view_list" model="ir.ui.view">
        <field name="name">requisition.order.view.list</field>
        <field name="model">requisition.order</field>
        <field name="arch" type="xml">
            <list editable="bottom" delete="0 if state not in ['new','waiting_department_approval','waiting_head_approval'] else 1">
                <field name="state" column_invisible="True"/>
                <field name="requisition_type"
                       invisible=" state == 'new'"
                       groups="store_operation_requests.employee_requisition_head,store_operation_requests.employee_requisition_manager"/>
                <field name="product_id"/>
                <field name="description"/>
                <field name="note" optional="show"/>
                <field name="quantity"/>
                <field name="qty_in_department"/>
                <field name="qty_on_hand"/>
                <field name="incoming_qty"/>
                <field name="uom"/>
            </list>
        </field>
    </record>
</odoo>